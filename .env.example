# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Credentials (for initial setup)
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password

# Cloudflare R2 - Uploads bucket
# Create R2 API token at https://dash.cloudflare.com/{account_id}/r2/api-tokens
R2_ACCOUNT_ID=0124c2167358caa5855f58febceadbe8
R2_UPLOADS_BUCKET_NAME=babalola-uploads
CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# After setting up cdn.babalola.dev custom domain, set to https://cdn.babalola.dev
# Before that, use the r2.dev public URL from the CF dashboard (R2 > bucket > Settings > Public Access)
R2_UPLOADS_PUBLIC_URL=https://cdn.babalola.dev

# Secure upload system
# Generate with: openssl rand -base64 32
UPLOAD_SESSION_SECRET=your-upload-session-secret-here
# Must match the value in infra/scripts/generate-upload-token.sh
UPLOAD_TOKEN_HMAC_SECRET=your-upload-token-hmac-secret-here

# ZeptoMail
ZEPTOMAIL_TOKEN=your-zeptomail-token-here
ZEPTOMAIL_FROM_ADDRESS=noreply@babalola.dev
ZEPTOMAIL_FROM_NAME=Babalola Brainiac
